BACKEND_PRODUCTION_MODE=true
HOST=0.0.0.0
PORT=8080

# Required in production mode.
DATABASE_URL=postgres://gymmap:<STRONG_DB_PASSWORD>@postgres:5432/gymmap
# Required for generic providers. Optional for Mercado Pago.
WEBHOOK_TOKEN=<WEBHOOK_TOKEN_OPTIONAL_FOR_MERCADOPAGO>
WEBHOOK_SIGNING_SECRET=<WEBHOOK_SIGNING_SECRET>
JWT_HS256_SECRET=<JWT_HS256_SECRET>
CORS_ALLOW_ORIGIN=https://app.seudominio.com
ADMIN_API_TOKEN=<STRONG_ADMIN_TOKEN_MIN_24_CHARS>
PIX_PROVIDER_MODE=external
PIX_PROVIDER_VENDOR=mercado_pago
PIX_PROVIDER_BASE_URL=https://api.mercadopago.com
PIX_PROVIDER_API_KEY=<PIX_PROVIDER_API_KEY>
PIX_MP_DEFAULT_PAYER_EMAIL=<YOUR_PIX_PAYER_EMAIL>
PIX_MP_NOTIFICATION_URL=https://api.seudominio.com/v1/webhooks/pix
# Optional if you migrate paid plans to Google Play Billing validation:
PLAY_PACKAGE_NAME=com.devia.gymmap
PLAY_SERVICE_ACCOUNT_JSON_BASE64=<BASE64_OF_SERVICE_ACCOUNT_JSON>
PLAY_PRODUCT_ID_SMART=smart_mensal
PLAY_PRODUCT_ID_PRO=pro_mensal
PLAY_PRODUCT_ID_ELITE=elite_mensal

# Optional hardening/behavior.
WEBHOOK_SIGNING_SECRET_PREVIOUS=
WEBHOOK_SIGNATURE_TOLERANCE_SEC=300
JWT_ISSUER=gymmap-backend
JWT_ACCESS_TTL_SEC=2592000
PLAY_BILLING_ALLOW_UNVERIFIED=false
PIX_PROVIDER_CHARGE_PATH=/v1/payments
PIX_PROVIDER_STATUS_PATH_TEMPLATE=/v1/payments/{chargeId}
PIX_PROVIDER_TIMEOUT_SEC=12
RATE_LIMIT_REQUESTS_PER_MIN=240
RATE_LIMIT_LOGIN_ATTEMPTS_PER_MIN=15
RATE_LIMIT_BILLING_ATTEMPTS_PER_MIN=20
CHARGE_RETENTION_DAYS=120
WEBHOOK_RETENTION_DAYS=60
CROWD_REPORT_RETENTION_DAYS=45
REQUEST_LOG_DISABLED=false

# Login users (required if you want in-app login endpoint enabled).
AUTH_USERS_JSON={"admin":"<STRONG_PASSWORD>"}
AUTH_DEFAULT_PASSWORD=
